# Copy to .env.local for local development. Never commit real server secrets.
# Public browser configuration: publishable keys are not authorization boundaries.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Verified production HTTPS origin for canonical links/sitemap; omit until confirmed.
VITE_SITE_ORIGIN=

# Server runtime configuration; never prefix these secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional operator-only Drizzle migration URL; contains database credentials.
LOVABLE_DB_MIGRATION_URL=
LOVABLE_CRON_SECRET=
# Optional previous secret, only during rotation.
LOVABLE_CRON_SECRET_PREVIOUS=

# Edge Function secrets: configure in Lovable Cloud, not the frontend build.
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and service role key.
SUPABASE_ANON_KEY=
# Comma-separated exact approved site origins, including local/staging when needed.
ENQUIRY_ALLOWED_ORIGINS=
ENQUIRY_RATE_SALT=
MAPBOX_ACCESS_TOKEN=
# Optional alternative routing provider when Mapbox is not configured.
OPENROUTESERVICE_API_KEY=
# Lovable AI Gateway backend key, supplied by the AI connector.
LOVABLE_API_KEY=
